# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible provider: set its key, base URL, and model ID.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional overrides (otherwise all roles use OPENAI_MODEL)
# CS329Z_GRADING_MODEL=your-model-id
# CS329Z_USER_MODEL=your-model-id
# CS329Z_JUDGE_MODEL=your-model-id
# CS329Z_REASONING_EFFORT=low  # only set if supported by your provider/model
# CS329Z_EVAL_SLICE=5         # run live tests on the first N items only
